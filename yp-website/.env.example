# Neon Postgres connection string. In the Neon console, use the *pooled*
# connection string (has "-pooler" in the hostname) — serverless functions
# open/close connections constantly and the pooler handles that correctly.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Shared password for the /admin portal. Pick a long random value.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie so it can't be forged.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="change-me-too"
